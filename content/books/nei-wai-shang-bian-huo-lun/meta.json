    {
      "slug": "02-juan-shang",
      "title": "卷上",
      "chars": 5265,
      "headings": [
        "辨陰證、陽證",
        "辨脈",
        "辨寒熱",
        "辨外感八風之邪",
        "辨手心、手背",
        "辨口鼻",
        "辨氣少氣盛",
        "辨頭痛",
        "辨筋骨四肢",
        "辨外傷不惡食",
        "辨渴與不渴",
        "辨勞役受病表虛不作表實治之",
        "辨證與中熱頗相似"
      ]
    },
    {
      "slug": "03-juan-zhong",
      "title": "卷中",
      "chars": 8790,
      "headings": [
        "飲食勞倦論",
        "四時用藥加減法",
        "暑傷胃氣論",
        "肺之脾胃虛方"
      ]
    },
    {
      "slug": "04-juan-xia",
      "title": "卷下",
      "chars": 9390,
      "headings": [
        "辨內傷飲食用藥所宜所禁",
        "飲食自倍腸胃乃傷分而治之",
        "論酒客病",
        "臨病制方",
        "隨時用藥",
        "吐法宜用，辨上部有脈，下部無脈",
        "重明木鬱則達之之理"
      ]
    }
  ]
