    {
      "slug": "01-ti-yao",
      "title": "提要",
      "chars": 507,
      "headings": []
    },
    {
      "slug": "02-juan-shang",
      "title": "卷上",
      "chars": 11751,
      "headings": [
        "針灸問對卷上",
        "或曰針灸當明經絡可以暁否",
        "問曰榮衛之氣亦有别乎",
        "或曰經脉與絡脉異乎",
        "或曰經病絡病治有異乎",
        "或曰經病亦有宜刺者乎",
        "或曰六府病形刺法何如",
        "或曰精氣津液血脉亦有别乎",
        "或曰形氣病氣何以别之",
        "或曰諸病逆順可得聞乎",
        "或曰癰疽何以治之",
        "或曰水腫之病宜刺乎",
        "或曰匹夫大人刺法同乎",
        "或曰三虚三實者何謂也",
        "或曰八穴治病多有効者何如",
        "或曰針三隂交主何病也",
        "或曰傷寒刺期門穴者何如",
        "問曰針刺失宜亦能殺人否乎",
        "或曰針灸宜避天忌日何也",
        "或曰針家亦診脉否",
        "或曰針家亦察色否"
      ]
    },
    {
      "slug": "03-juan-zhong",
      "title": "卷中",
      "chars": 22223,
      "headings": [
        "針灸問對卷中",
        "經曰五藏有俞",
        "或曰井榮俞經合主何病也",
        "三才法",
        "十四法",
        "已上四法通關過節者也",
        "又曰有見如"
      ]
    },
    {
      "slug": "04-juan-xia",
      "title": "卷下",
      "chars": 9420,
      "headings": [
        "針灸問對卷下",
        "或曰頭目之疾灸之何如",
        "或曰灸有補㵼乎",
        "十五絡脉歌",
        "肺經",
        "胃經",
        "心包絡經",
        "三焦經",
        "膽經",
        "任脉俞穴",
        "經穴起止歌",
        "十二經納支干歌",
        "經脉交㑹八穴歌",
        "八㑹歌",
        "肺經多氣而少血是動",
        "十二經井滎俞經合歌",
        "禁針穴歌",
        "重解虚則補之四句"
      ]
    }
  ]
}
