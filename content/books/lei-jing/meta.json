  "chars": 635337,
  "chapters": [
    {
      "slug": "01-ti-yao",
      "title": "提要",
      "chars": 1906,
      "headings": []
    },
    {
      "slug": "02-juan-yi",
      "title": "卷一",
      "chars": 6895,
      "headings": [
        "類經名義",
        "攝生類",
        "上古聖人之教下",
        "古有真人至人聖人賢人",
        "四氣調神",
        "春三月此謂發陳",
        "天氣清静光眀者也",
        "四時隂陽從之則生逆之則死",
        "逆春氣則少陽不生肝氣内變",
        "不治已病治未病"
      ]
    },
    {
      "slug": "03-juan-er",
      "title": "卷二",
      "chars": 9174,
      "headings": [
        "隂陽應象",
        "黄帝曰隂陽者天地之道也",
        "法隂陽",
        "帝曰法隂陽奈何",
        "天不足西北地不滿東南",
        "天精地形氣通於人",
        "隂陽之中復有隂陽",
        "故曰隂中有隂陽中有陽"
      ]
    },
    {
      "slug": "04-juan-san",
      "title": "卷三",
      "chars": 24241,
      "headings": [
        "十二官",
        "藏象",
        "帝曰藏象何如",
        "藏府有相合三焦曰孤府",
        "肺合大腸大腸者傳道之府",
        "五藏之應各有收受",
        "帝曰五藏應四時各有收受乎",
        "四時隂陽外内之應",
        "五氣之合人萬物之生化",
        "脾不主時",
        "帝曰脾不主時何也",
        "生成篇○八）",
        "本神",
        "五藏異藏虛實異病",
        "氣口獨為五藏主",
        "帝曰氣口何以獨為五藏主",
        "食飲之氣歸輸藏府",
        "食氣入胃散精於肝淫氣於筋",
        "有子無子女盡七七男盡八八",
        "附種子說）",
        "天年常度",
        "壽夭",
        "人身應天地",
        "婦人無鬚氣血多少"
      ]
    },
    {
      "slug": "05-juan-si",
      "title": "卷四",
      "chars": 21462,
      "headings": [
        "老壯少小脂膏肉瘦之别",
        "血氣隂陽清濁",
        "首面耐寒因於氣聚",
        "十一）",
        "耐痛耐毒強弱不同",
        "竒恒藏府藏寫不同",
        "逆順相傳至困而死",
        "精氣津液血脉脫則為病",
        "腸胃小大之數",
        "平人絶穀七日而死",
        "本藏二十五變",
        "身形候藏府",
        "人有隂陽治分五態",
        "隂陽二十五人",
        "五音五味分配藏府",
        "右徴與少徴調右手太陽上",
        "少徴與大宫調左手陽明上",
        "右角與大角調右足少陽下",
        "衆羽與少羽調右足太陽下",
        "桎羽與衆羽調右足太陽下",
        "判角與少角調右足少陽下",
        "大宫與上角同右足陽明上",
        "少羽與大羽同右足太陽下",
        "加宫與大宫同左足少陽上",
        "質判與大宫同左手太陽下",
        "大羽與大角同右足太陽上",
        "右徴少徴質徴上徴判徴",
        "少宫上宫大宫加宫左角宫"
      ]
    },
    {
      "slug": "06-juan-wu",
      "title": "卷五",
      "chars": 24454,
      "headings": [
        "診法常以平旦",
        "黄帝問曰診法何如",
        "部位",
        "尺内兩傍則季脇也",
        "呼吸至數",
        "黃帝問曰平人何如",
        "五藏之氣脉有常數",
        "七診",
        "診有十度診有隂陽",
        "診有大方",
        "是以診有大方坐起有常",
        "脉合四時隂陽規矩",
        "四時藏脉病有太過不及",
        "脉分四時無胃曰死",
        "逆從四時無胃亦死",
        "○黃帝曰",
        "五藏平病死脉胃氣為本",
        "三陽脉體",
        "太陽脉至洪大以長",
        "六經獨至病脉分治",
        "寸口尺脉診諸病",
        "三診六變與尺相應",
        "診尺論疾"
      ]
    },
    {
      "slug": "07-juan-liu",
      "title": "卷六",
      "chars": 25716,
      "headings": [
        "藏脉六變病刺不同",
        "諸脉證診法",
        "夫脉者血之府也",
        "闗格",
        "孕脉",
        "婦人手少隂脉動甚者任子也",
        "諸經脉證死期",
        "肝滿腎滿肺滿皆實即為腫",
        "決死生",
        "帝曰决死生奈何",
        "脉有隂陽真藏",
        "骨枯肉陷真藏脉見者死",
        "真藏脉死期",
        "○肝見庚辛死",
        "隂搏陽别謂之有子",
        "精明五色",
        "夫精明五色者氣之華也",
        "五官五閲",
        "色藏部位脉病易難",
        "色脉諸診",
        "能合脉色可以萬全",
        "經有常色絡無常變",
        "新病久病毁傷脉色",
        "五藏五色死生",
        "故色見青如草兹者死"
      ]
    },
    {
      "slug": "08-juan-qi",
      "title": "卷七",
      "chars": 26314,
      "headings": [
        "雷公問於黃帝曰禁脉之言",
        "○十二經脉",
        "抵胃屬小腸",
        "十二經離合",
        "十二經筋結支别",
        "十五别絡病刺",
        "經絡之辨刺診之法",
        "氣穴三百六十五",
        "孫絡谿谷之應",
        "氣府三百六十五",
        "足太陽脉氣所發者七十八穴",
        "喉中央二",
        "項腋頭面諸經之次",
        "缺盆之中任脉也名曰天突",
        "五藏背腧",
        "諸經標本氣街"
      ]
    },
    {
      "slug": "09-juan-ba",
      "title": "卷八",
      "chars": 20676,
      "headings": [
        "三經獨動",
        "井滎腧經合數",
        "十二原",
        "五藏五腧六府六腧",
        "脉度",
        "骨度",
        "骨空",
        "輔骨上橫骨下為楗",
        "十二經血氣表裏",
        "諸脉髓筋血氣谿谷所屬",
        "諸脉者皆屬於目",
        "五藏常内閲於上七竅也",
        "營衛三焦",
        "營氣運行之次",
        "衛氣運行之次"
      ]
    },
    {
      "slug": "10-juan-jiu",
      "title": "卷九",
      "chars": 15947,
      "headings": [
        "任衝督脉為病",
        "蹻脉分男女",
        "隂陽離合",
        "諸經根結開闔病刺",
        "隂陽内外病生有紀",
        "人之四海",
        "十二經水隂陽刺灸之度",
        "手足隂陽繫日月",
        "身形應九野○天忌",
        "黃帝曰願聞身形應九野奈何"
      ]
    },
    {
      "slug": "11-juan-shi",
      "title": "卷十",
      "chars": 2952,
      "headings": [
        "六氣標本所從不同",
        "帝曰六氣標本所從不同奈何",
        "病有標本取有逆順",
        "病有標本刺有逆從",
        "標本逆從治有先後"
      ]
    },
    {
      "slug": "12-juan-shi-yi",
      "title": "卷十一",
      "chars": 3942,
      "headings": [
