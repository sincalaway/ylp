    {
      "slug": "02-juan-shang",
      "title": "卷上",
      "chars": 17463,
      "headings": [
        "難經本義卷上",
        "故分寸為尺分尺為寸",
        "故曰覆溢",
        "是其真藏之脈人不病而死也",
        "六者之王說見下文",
        "如有變奈何",
        "然是其病有内外證",
        "其病為之奈何",
        "病實而脈虚也",
        "脫血脈實相反也",
        "陽病見隂脈相反也",
        "其外痼疾同法耶将異也",
        "反者男得女脈女得男脈也",
        "其為病何如",
        "此五十九難之文錯簡在此"
      ]
    },
    {
      "slug": "03-juan-xia",
      "title": "卷下",
      "chars": 19121,
      "headings": [
        "難經本義卷下",
        "三十五難曰五藏各有所",
        "伏梁伏而不動如梁木然",
        "此五泄之目下文詳之",
        "小腸泄者溲而便膿血少腹痛",
        "詳見靈樞二十四篇厥逆也",
        "其五藏氣相干名厥心痛"
      ]
    }
  ]
